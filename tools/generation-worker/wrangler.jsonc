{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "inkquest-generation-worker",
  "main": "dist/worker.js",
  "no_bundle": true,
  "find_additional_modules": true,
  "compatibility_date": "2026-07-21",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "GENERATION_ENABLED": "false",
    "SUPABASE_URL": "https://irzfnntlixbtccdfjcpm.supabase.co",
    "LLM_PROVIDER": "openai",
    "OPENAI_MODEL": "gpt-6-luna",
    "OPENAI_REASONING_EFFORT": "low",
    "OPENAI_MAX_OUTPUT_TOKENS": "6000",
    "GENERATION_DICTIONARY_VERSION": "lex-244056cfff1d40670ec63f7b"
  },
  "observability": { "enabled": true }
  // No consumers, producers, Cron or secret values. Both approved secrets are
  // configured remotely. Cancellation and schema installation are verified.
  // Dictionary import/verification must finish before consumer/Cron activation.
}

# Documentation only: not loaded automatically. Never put real secrets in this file.
# Set these variables privately on the story-pipeline Worker (not NEXT_PUBLIC_*).
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Alias supported if OPENAI_API_KEY is unset or blank; keep real values private.
OPENAI_KEY=
# Required: a Responses + JSON mode model enabled for your interview organization/project.
OPENAI_MODEL=
# Optional routing headers: use actual IDs, never the display name "interview".
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_MAX_OUTPUT_TOKENS=6000
# Optional; the selected model must support this effort.
OPENAI_REASONING_EFFORT=medium
LLM_PROMPT_VERSION=opening-v1

# Retain existing Gemini values privately for manual rollback via LLM_PROVIDER=gemini.
# Omitting LLM_PROVIDER also keeps the pre-existing chat-completions behavior.
LLM_CHAT_COMPLETIONS_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_API_KEY=
LLM_MODEL=
